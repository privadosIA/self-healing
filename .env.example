# Copy to .env and adjust. Never commit real values.
# Any secret can instead be read from a file with HEALER_<NAME>_FILE (for example HEALER_GITEA_TOKEN_FILE).

# --- Server ---
HEALER_LISTEN_ADDR=:8080
HEALER_DB_PATH=healerd.db
HEALER_LOG_LEVEL=info

# --- Egress allowlist (required) ---
# Comma-separated domain suffixes and/or CIDRs. The daemon refuses to start if it is empty
# or if the Gitea, SonarQube or LLM host is not covered by it.
HEALER_ALLOWED_HOSTS=example.com

# --- Gitea (required) ---
HEALER_GITEA_URL=https://gitea.example.com
HEALER_GITEA_TOKEN=changeme
HEALER_WEBHOOK_SECRET=changeme

# --- Trivy reports (optional: empty disables PUT /reports) ---
HEALER_REPORTS_TOKEN=

# --- SonarQube (optional: empty URL disables the Sonar scanner) ---
HEALER_SONAR_URL=
HEALER_SONAR_TOKEN=

# --- LLM, OpenAI-compatible API (required) ---
HEALER_LLM_URL=http://llm.example.com/v1
HEALER_LLM_API_KEY=
HEALER_LLM_MODEL=changeme

# --- Commit author ---
HEALER_GIT_AUTHOR_NAME=ci-healer-bot
HEALER_GIT_AUTHOR_EMAIL=ci-healer-bot@users.noreply.invalid

# --- Timeouts ---
HEALER_LLM_TIMEOUT=5m
HEALER_JOB_TIMEOUT=15m
HEALER_SHUTDOWN_GRACE=30s

# --- Behavior ---
HEALER_WORKERS=2
HEALER_MAX_OPEN_PRS=3
HEALER_SNIPPET_CONTEXT_LINES=30
HEALER_EXCLUDE_GLOBS=**/*.lock,**/migrations/**,**/*secret*
